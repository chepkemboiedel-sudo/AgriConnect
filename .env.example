# Copy this file to ".env" to turn on a real LLM for grounded answers.
# WITHOUT a key the app still runs fully offline (local retrieval + extractive
# answers). You paste your own key here; it is never committed and never leaves
# your machine except in calls to the provider you choose.

# OPENAI_API_KEY=sk-...your-key...
# AGRI_CHAT_MODEL=gpt-4o-mini

# Optional tuning (defaults shown):
# AGRI_TOP_K=3
# AGRI_ABSTAIN_THRESHOLD=0.06
# AGRI_MAX_STEPS=3
